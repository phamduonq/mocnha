# Cấu hình Cổng máy chủ
PORT=3000

# Cấu hình Supabase (Lấy từ Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cấu hình Google Gemini API (Lấy từ Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key

# Khóa bí mật ký Webhook Cổng thanh toán (HMAC-SHA256)
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret-key
